# Copy to .env.local for development. Production values are set in Coolify (see docs/deployment.md).
APP_URL=http://localhost:3100
DEFAULT_LOCALE=de
# Operators create communities on /operator; the seed creates an active account for each address.
OPERATOR_EMAILS=you@example.com

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me
APP_ENCRYPTION_KEY=change-me-change-me-change-me

DATABASE_URL=postgres://courses:courses@localhost:5434/courses
REDIS_URL=redis://localhost:6380
UPLOAD_DIR=./data/uploads

# Mailpit from docker-compose.dev.yml (UI http://localhost:8026)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM="AI-Up Kurse <noreply@ai-up.club>"
