{
  "name": "ai-up-courses",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx watch --env-file-if-exists=.env.local worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node22 --outdir=dist --outbase=. --packages=external --format=cjs",
    "worker:start": "node dist/worker/index.js",
    "migrate:build": "esbuild src/server/db/migrate.ts --bundle --platform=node --target=node22 --outfile=dist/migrate.js --format=cjs --external:pg-native"
  },
  "dependencies": {
    "better-auth": "^1.7.0",
    "bullmq": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
